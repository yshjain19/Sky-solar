<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Sky Solar provides smart rooftop solar solutions for homes, businesses and housing societies. Calculate your savings and get a free solar consultation.">
  <meta name="keywords" content="Sky Solar, rooftop solar, solar panels India, solar energy, solar calculator, commercial solar, residential solar, solar subsidy, on grid solar">
  <meta name="author" content="Sky Solar">
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.skysolar.in/">
  <meta property="og:title" content="Sky Solar | Rooftop Solar Solutions for Homes & Businesses">
  <meta property="og:description" content="Sky Solar provides smart rooftop solar solutions for homes, businesses and housing societies. Calculate your savings and get a free solar consultation.">
  
  <link rel="canonical" href="https://www.skysolar.in/">
  
  <title><%= typeof title !== 'undefined' ? title : 'Sky Solar' %> | Rooftop Solar Solutions</title>
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/public/css/style.css">
  
  <link rel="icon" type="image/x-icon" href="/public/icons/favicon.ico">
</head>
<body>

  <!-- Include Shared Navbar -->
  <%- include('../includes/navbar') %>

  <!-- Main Body Content -->
  <main id="main-content" style="min-height: 75vh;">
    <!-- Include Shared Flash Messages -->
    <%- include('../includes/flash') %>
    
    <%- body %>
  </main>

  <!-- Include Shared Footer -->
  <%- include('../includes/footer') %>

  <!-- Bootstrap 5 Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  
  <!-- Custom Client-Side Script -->
  <script src="/public/js/script.js"></script>
</body>
</html>
