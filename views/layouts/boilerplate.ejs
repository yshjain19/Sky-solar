<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Sky Solar provides smart, custom rooftop solar solutions for homes, commercial entities, and societies in Indore, Madhya Pradesh. Claim up to ₹78,000 PM Surya Ghar subsidy and calculate your 25-year lifetime savings.' %>">
  <meta name="keywords" content="Sky Solar Indore, rooftop solar panels Indore, solar energy Madhya Pradesh, solar subsidy Indore, PM Surya Ghar Yojana Indore, commercial solar Indore, residential solar Indore, solar cost calculator, Harsh Jain solar, green energy Indore">
  <meta name="author" content="Sky Solar">
  <meta name="google-site-verification" content="n0TPgwEvsHs1AsQA1nlncfBbwXJfuoEjprBGAdHyxMU">
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= siteUrl %>/">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Sky Solar | Rooftop Solar Solutions in Indore, MP' %>">
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Sky Solar provides smart, custom rooftop solar solutions for homes, commercial entities, and societies in Indore, Madhya Pradesh. Claim up to ₹78,000 PM Surya Ghar subsidy and calculate your 25-year lifetime savings.' %>">
  <meta property="og:image" content="<%= siteUrl %>/public/images/logo.png">
  <meta property="og:image:alt" content="Sky Solar Logo">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'Sky Solar | Rooftop Solar Solutions in Indore, MP' %>">
  <meta name="twitter:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Sky Solar provides smart, custom rooftop solar solutions for homes, commercial entities, and societies in Indore, Madhya Pradesh. Claim up to ₹78,000 PM Surya Ghar subsidy and calculate your 25-year lifetime savings.' %>">
  <meta name="twitter:image" content="<%= siteUrl %>/public/images/logo.png">
  
  <link rel="canonical" href="<%= siteUrl %>/">
  
  <title><%= typeof title !== 'undefined' ? title : 'Sky Solar | Rooftop Solar Solutions in Indore, MP' %></title>
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/public/css/style.css">
  <link rel="icon" href="/favicon.png" type="image/png">
</head>
<body>

  <!-- Include Shared Navbar -->
  <%- include('../includes/navbar') %>

  <!-- Main Body Content -->
  <main id="main-content" style="min-height: 75vh;">
    <!-- Include Shared Flash Messages -->
    <%- include('../includes/flash') %>
    
    <%- body %>
  </main>

  <!-- Include Shared Footer -->
  <%- include('../includes/footer') %>

  <!-- Bootstrap 5 Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  
  <!-- Custom Client-Side Script -->
  <script src="/public/js/script.js"></script>
</body>
</html>
