<!-- HERO SECTION -->
<section class="hero-section">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6 hero-content fade-in-up" id="hero-left">
        <div class="hero-stats-badge">
          <i class="bi bi-shield-check-fill"></i> Best-in-class Rooftop Solar Solutions
        </div>
        <h1>Turn Sunlight Into Savings.</h1>
        <p>Smart rooftop solar solutions designed to reduce your electricity bills and power your future with clean, sustainable energy.</p>
        
        <div class="d-flex flex-wrap gap-3">
          <a href="/contact" class="btn btn-premium-primary">Get Free Solar Consultation</a>
          <a href="/solar#calculator" class="btn btn-premium-secondary text-white border-white">Calculate Your Savings</a>
        </div>

        <!-- Trust Stats Row -->
        <div class="hero-stats-grid row g-3 text-center text-md-start">
          <div class="col-6 col-md-3 hero-stat-item">
            <h3 class="counter-value" data-target="10000">10,000+</h3>
            <p>Happy Customers</p>
          </div>
          <div class="col-6 col-md-3 hero-stat-item">
            <h3 class="counter-value" data-target="50">50+</h3>
            <p>MW Installed</p>
          </div>
          <div class="col-6 col-md-3 hero-stat-item">
            <h3 class="counter-value" data-target="25">25+</h3>
            <p>Years Panel Life</p>
          </div>
          <div class="col-6 col-md-3 hero-stat-item">
            <h3 class="counter-value" data-target="100">100%</h3>
            <p>Expert Install</p>
          </div>
        </div>
      </div>
      
      <div class="col-lg-6 hero-image-wrapper text-center">
        <img src="/public/images/hero_bg.png" alt="Sky Solar Premium Rooftop Installation" class="img-fluid rounded-4">
      </div>
    </div>
  </div>
</section>

<!-- WHY CHOOSE SKY SOLAR -->
<section class="section-padding">
  <div class="container">
    <div class="text-center mb-5 fade-in-up">
      <h2 class="section-title">Why Choose Sky Solar?</h2>
      <p class="text-muted mx-auto" style="max-width: 600px;">We deliver seamless, end-to-end solar solutions optimized for peak output and hassle-free long-term savings.</p>
    </div>
    
    <div class="row g-4">
      <div class="col-md-6 col-lg-3 fade-in-up">
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <i class="bi bi-pencil-square"></i>
          </div>
          <h3>Smart Solar Design</h3>
          <p class="text-muted">Customized layout designed around your roof's shadow paths and monthly power bills to ensure maximum sun capture.</p>
        </div>
      </div>
      
      <div class="col-md-6 col-lg-3 fade-in-up">
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <i class="bi bi-tools"></i>
          </div>
          <h3>Hassle-Free Install</h3>
          <p class="text-muted">Full-service technical installation handles initial feasibility surveys, safety permissions, and final grid commissioning.</p>
        </div>
      </div>
      
      <div class="col-md-6 col-lg-3 fade-in-up">
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <i class="bi bi-tags"></i>
          </div>
          <h3>Transparent Pricing</h3>
          <p class="text-muted">Honest component quotes without hidden fees or surprise maintenance premiums. You pay exactly what we promise.</p>
        </div>
      </div>
      
      <div class="col-md-6 col-lg-3 fade-in-up">
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <i class="bi bi-chat-heart"></i>
          </div>
          <h3>Reliable Support</h3>
          <p class="text-muted">Round-the-clock remote energy audits, yearly panel tuneups, and fast on-site support to keep your systems running.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SOLAR IMPACT -->
<section class="section-padding bg-dark text-white text-center position-relative overflow-hidden" style="background: linear-gradient(rgba(15, 76, 58, 0.95), rgba(26, 31, 38, 0.98));">
  <div class="container py-4">
    <div class="text-center mb-5 fade-in-up">
      <h2 class="text-white">Our Environmental Impact</h2>
      <p class="text-white-50 mx-auto" style="max-width: 600px;">Every panel we install helps reduce fossil fuel dependency. See our combined progress:</p>
    </div>
    
    <div class="row g-4">
      <div class="col-md-3 fade-in-up">
        <div class="impact-stat-card">
          <h3 class="counter-val" data-target="10000">0</h3>
          <p>Homes Powered</p>
        </div>
      </div>
      <div class="col-md-3 fade-in-up">
        <div class="impact-stat-card">
          <h3 class="counter-val" data-target="50">0</h3>
          <p>MW Solar Capacity Installed</p>
        </div>
      </div>
      <div class="col-md-3 fade-in-up">
        <div class="impact-stat-card">
          <h3 class="counter-val" data-target="25">0</h3>
          <p>Years Panel Lifespan</p>
        </div>
      </div>
      <div class="col-md-3 fade-in-up">
        <div class="impact-stat-card">
          <h3 class="counter-val" data-target="72500">0</h3>
          <p>Tons CO₂ Reduced</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PROJECT SHOWCASE -->
<section class="section-padding">
  <div class="container">
    <div class="text-center mb-5 fade-in-up">
      <h2>Featured Projects Portfolio</h2>
      <p class="text-muted mx-auto" style="max-width: 600px;">Take a look at some of our premium installations delivering real savings for our partners.</p>
      
      <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
        <button class="gallery-filter-btn active" data-filter="all">All Projects</button>
        <button class="gallery-filter-btn" data-filter="residential">Residential</button>
        <button class="gallery-filter-btn" data-filter="commercial">Commercial</button>
        <button class="gallery-filter-btn" data-filter="apartments">Apartments</button>
        <button class="gallery-filter-btn" data-filter="industrial">Industrial</button>
      </div>
    </div>

    <div class="row g-4" id="project-gallery-grid">
      <% if (locals.projects && projects.length > 0) { %>
        <% projects.forEach(function(proj) { %>
          <div class="col-md-6 col-lg-4 project-item fade-in-up" data-category="<%= proj.category %>">
            <div class="project-card">
              <div class="project-img-wrapper">
                <img src="<%= proj.image %>" alt="<%= proj.title %>" loading="lazy">
                <span class="project-badge"><%= proj.type %></span>
              </div>
              <div class="project-details">
                <h4><%= proj.title %></h4>
                <p class="meta"><i class="bi bi-geo-alt-fill text-gold me-1"></i> <%= proj.location %> | <strong><%= proj.capacity %></strong></p>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12 text-center text-muted">No featured projects found.</div>
      <% } %>
    </div>
  </div>
</section>

