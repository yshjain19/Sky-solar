<section class="section-padding bg-light-mint">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-5 fade-in-up">
      <div>
        <span class="text-uppercase text-gold fw-bold tracking-wider">Internal Portal</span>
        <h1 class="h2 text-success mt-1">Management Dashboard</h1>
        <p class="text-muted">Welcome, Admin. Overview of operations, leads, and assets.</p>
      </div>
      <div>
        <a href="/admin/logout" class="btn btn-outline-danger btn-sm rounded-pill"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
      </div>
    </div>

    <!-- Administrative Mini-Nav Tabs -->
    <div class="row g-3 mb-5 fade-in-up">
      <div class="col-md-3">
        <a href="/admin/dashboard" class="card text-decoration-none bg-success text-white border-0 shadow-sm h-100">
          <div class="card-body p-4 text-center">
            <i class="bi bi-speedometer2 fs-1 mb-2"></i>
            <h5 class="mb-0">Main Overview</h5>
          </div>
        </a>
      </div>
      <div class="col-md-3">
        <a href="/admin/leads" class="card text-decoration-none bg-white text-dark border-0 shadow-sm h-100 glass-card">
          <div class="card-body p-4 text-center">
            <i class="bi bi-envelope-paper-fill fs-1 text-success mb-2"></i>
            <h5 class="mb-0">Leads Inbox</h5>
          </div>
        </a>
      </div>
      <div class="col-md-3">
        <a href="/admin/customers" class="card text-decoration-none bg-white text-dark border-0 shadow-sm h-100 glass-card">
          <div class="card-body p-4 text-center">
            <i class="bi bi-person-badge-fill fs-1 text-success mb-2"></i>
            <h5 class="mb-0">Customers database</h5>
          </div>
        </a>
      </div>
      <div class="col-md-3">
        <a href="/admin/projects" class="card text-decoration-none bg-white text-dark border-0 shadow-sm h-100 glass-card">
          <div class="card-body p-4 text-center">
            <i class="bi bi-images fs-1 text-success mb-2"></i>
            <h5 class="mb-0">Showcase gallery</h5>
          </div>
        </a>
      </div>
    </div>

    <!-- Stats Grid Widgets -->
    <div class="row g-4 mb-5 fade-in-up">
      <!-- Widget 1: Total Leads -->
      <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm p-4 bg-white rounded-3">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <h6 class="text-uppercase text-muted small mb-1">Total Leads</h6>
              <span class="fs-2 fw-bold text-success font-headings"><%= leadCount %></span>
            </div>
            <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
              <i class="bi bi-envelope-open-fill fs-4"></i>
            </div>
          </div>
        </div>
      </div>

      <!-- Widget 2: Converted Customers -->
      <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm p-4 bg-white rounded-3">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <h6 class="text-uppercase text-muted small mb-1">Customers</h6>
              <span class="fs-2 fw-bold text-success font-headings"><%= customerCount %></span>
            </div>
            <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
              <i class="bi bi-person-check-fill fs-4"></i>
            </div>
          </div>
        </div>
      </div>

      <!-- Widget 3: Total Power Installed -->
      <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm p-4 bg-white rounded-3">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <h6 class="text-uppercase text-muted small mb-1">Installed Capacity</h6>
              <span class="fs-2 fw-bold text-success font-headings"><%= totalCapacity %> <span class="fs-6 fw-normal text-muted">kW</span></span>
            </div>
            <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
              <i class="bi bi-lightning-charge-fill fs-4"></i>
            </div>
          </div>
        </div>
      </div>

      <!-- Widget 4: Active Projects -->
      <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm p-4 bg-white rounded-3">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <h6 class="text-uppercase text-muted small mb-1">Gallery Projects</h6>
              <span class="fs-2 fw-bold text-success font-headings"><%= projectCount %></span>
            </div>
            <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
              <i class="bi bi-camera-fill fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Activity Panel -->
    <div class="row g-4 fade-in-up">
      <div class="col-lg-6">
        <div class="card border-0 shadow-sm bg-white p-4 h-100 rounded-3">
          <h3 class="h5 mb-4 text-success"><i class="bi bi-clock-history me-2"></i>Recent Leads Intake</h3>
          <% if (locals.recentLeads && recentLeads.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead>
                  <tr class="table-light">
                    <th>Name</th>
                    <th>City</th>
                    <th>Bill</th>
                    <th>Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% recentLeads.forEach(function(lead) { %>
                    <tr>
                      <td><strong><%= lead.fullName %></strong></td>
                      <td><%= lead.city %></td>
                      <td>₹<%= Number(lead.monthlyBill).toLocaleString('en-IN') %></td>
                      <td><%= new Date(lead.createdAt).toLocaleDateString('en-IN', {month: 'short', day: 'numeric'}) %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <p class="text-muted text-center py-4">No recent leads found.</p>
          <% } %>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="card border-0 shadow-sm bg-white p-4 h-100 rounded-3">
          <h3 class="h5 mb-4 text-success"><i class="bi bi-star-fill me-2"></i>Operation Quick Actions</h3>
          <p class="text-muted">Perform routine portal management configurations easily:</p>
          <div class="d-grid gap-3">
            <a href="/admin/leads" class="btn btn-outline-success text-start py-3"><i class="bi bi-envelope-exclamation-fill me-2"></i> Review and convert new leads inbox</a>
            <a href="/admin/projects" class="btn btn-outline-success text-start py-3"><i class="bi bi-plus-circle-fill me-2"></i> Upload new project details to public gallery</a>
            <a href="/admin/customers" class="btn btn-outline-success text-start py-3"><i class="bi bi-person-rolodex me-2"></i> Review active customers list database</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
