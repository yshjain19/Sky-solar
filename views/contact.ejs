<section class="section-padding bg-light-mint">
  <div class="container">
    <div class="text-center mb-5 fade-in-up">
      <span class="text-uppercase text-gold fw-bold tracking-wider">Get In Touch</span>
      <h1 class="mt-2 text-success">Schedule A Free Solar Consultation</h1>
      <p class="text-muted mx-auto" style="max-width: 600px;">Fill out the form below, and our senior solar consultant will call you back within 24 hours to design your customized rooftop solar roadmap.</p>
    </div>

    <div class="row g-5">
      <!-- Left Info Panel -->
      <div class="col-lg-5 fade-in-up">
        <div class="contact-info-side d-flex flex-column justify-content-between">
          <div>
            <h3>Contact Information</h3>
            <p class="opacity-75">Connect directly with our headquarters or visit us to talk to our solar designers.</p>
            
            <ul class="contact-info-list">
              <li>
                <i class="bi bi-geo-alt-fill"></i>
                <div>
                  <h5>Corporate Office</h5>
                  <p class="opacity-75 mb-0">Sky Solar Towers, 4th Floor, Sector 5, HSR Layout, Bengaluru, Karnataka - 560102</p>
                </div>
              </li>
              <li>
                <i class="bi bi-telephone-fill"></i>
                <div>
                  <h5>Sales Hotline</h5>
                  <p class="opacity-75 mb-0">+91-9876543210 / +91-9876543211</p>
                </div>
              </li>
              <li>
                <i class="bi bi-envelope-fill"></i>
                <div>
                  <h5>Email Support</h5>
                  <p class="opacity-75 mb-0">info@skysolar.in / sales@skysolar.in</p>
                </div>
              </li>
              <li>
                <i class="bi bi-clock-fill"></i>
                <div>
                  <h5>Business Hours</h5>
                  <p class="opacity-75 mb-0">Monday - Saturday: 9:00 AM - 6:00 PM</p>
                </div>
              </li>
            </ul>
          </div>

          <div class="pt-4 border-top border-white-50">
            <p class="mb-0 text-white-50">Providing solar solutions across major Indian cities: Bengaluru, Pune, Delhi NCR, Ahmedabad, Mumbai, and Chennai.</p>
          </div>
        </div>
      </div>

      <!-- Right Form Panel -->
      <div class="col-lg-7 fade-in-up">
        <div class="contact-form-side">
          <h3>Solar Consultation Request</h3>
          
          <form action="/leads" method="POST" id="contact-consult-form" novalidate>
            <div class="row g-3">
              
              <!-- Full Name -->
              <% const hasNameErr = locals.errors && errors.fullName; %>
              <div class="col-md-6 form-group-custom <%= hasNameErr ? 'has-error' : '' %>" id="fg-fullName">
                <label for="fullName" class="form-label">Full Name</label>
                <input type="text" name="fullName" class="form-control form-control-custom" id="fullName" value="<%= locals.formData ? formData.fullName : '' %>" placeholder="e.g. Rahul Sharma" required>
                <div class="invalid-feedback-custom"><%= hasNameErr ? errors.fullName : '' %></div>
              </div>

              <!-- Mobile Number -->
              <% const hasMobileErr = locals.errors && errors.mobileNumber; %>
              <div class="col-md-6 form-group-custom <%= hasMobileErr ? 'has-error' : '' %>" id="fg-mobileNumber">
                <label for="mobileNumber" class="form-label">Mobile Number</label>
                <input type="tel" name="mobileNumber" class="form-control form-control-custom" id="mobileNumber" value="<%= locals.formData ? formData.mobileNumber : '' %>" placeholder="10-digit Indian Number" required>
                <div class="invalid-feedback-custom"><%= hasMobileErr ? errors.mobileNumber : '' %></div>
              </div>

              <!-- Email Address -->
              <% const hasEmailErr = locals.errors && errors.email; %>
              <div class="col-md-12 form-group-custom <%= hasEmailErr ? 'has-error' : '' %>" id="fg-email">
                <label for="email" class="form-label">Email Address</label>
                <input type="email" name="email" class="form-control form-control-custom" id="email" value="<%= locals.formData ? formData.email : '' %>" placeholder="e.g. rahul@example.com" required>
                <div class="invalid-feedback-custom"><%= hasEmailErr ? errors.email : '' %></div>
              </div>

              <!-- City -->
              <% const hasCityErr = locals.errors && errors.city; %>
              <div class="col-md-6 form-group-custom <%= hasCityErr ? 'has-error' : '' %>" id="fg-city">
                <label for="city" class="form-label">City</label>
                <input type="text" name="city" class="form-control form-control-custom" id="city" value="<%= locals.formData ? formData.city : '' %>" placeholder="e.g. Bengaluru" required>
                <div class="invalid-feedback-custom"><%= hasCityErr ? errors.city : '' %></div>
              </div>

              <!-- PIN Code -->
              <% const hasPinErr = locals.errors && errors.pinCode; %>
              <div class="col-md-6 form-group-custom <%= hasPinErr ? 'has-error' : '' %>" id="fg-pinCode">
                <label for="pinCode" class="form-label">PIN Code</label>
                <input type="text" name="pinCode" class="form-control form-control-custom" id="pinCode" value="<%= locals.formData ? formData.pinCode : '' %>" placeholder="e.g. 560102" required>
                <div class="invalid-feedback-custom"><%= hasPinErr ? errors.pinCode : '' %></div>
              </div>

              <!-- Property Type -->
              <% const hasPropErr = locals.errors && errors.propertyType; %>
              <% const currentProp = locals.formData ? formData.propertyType : ''; %>
              <div class="col-md-6 form-group-custom <%= hasPropErr ? 'has-error' : '' %>" id="fg-propertyType">
                <label for="propertyType" class="form-label">Property Type</label>
                <select name="propertyType" class="form-select form-control-custom" id="propertyType" required>
                  <option value="" disabled <%= !currentProp ? 'selected' : '' %>>Select Property Type</option>
                  <option value="residential" <%= currentProp === 'residential' ? 'selected' : '' %>>Residential Home</option>
                  <option value="commercial" <%= currentProp === 'commercial' ? 'selected' : '' %>>Commercial / Office</option>
                  <option value="apartment" <%= currentProp === 'apartment' ? 'selected' : '' %>>Apartment Complex</option>
                  <option value="society" <%= currentProp === 'society' ? 'selected' : '' %>>Housing Society</option>
                </select>
                <div class="invalid-feedback-custom"><%= hasPropErr ? errors.propertyType : '' %></div>
              </div>

              <!-- Monthly Electricity Bill -->
              <% const hasBillErr = locals.errors && errors.monthlyBill; %>
              <div class="col-md-6 form-group-custom <%= hasBillErr ? 'has-error' : '' %>" id="fg-monthlyBill">
                <label for="monthlyBill" class="form-label">Monthly Electricity Bill (INR)</label>
                <div class="input-group">
                  <span class="input-group-text bg-white border-end-0 border-secondary-subtle">₹</span>
                  <input type="number" name="monthlyBill" class="form-control form-control-custom border-start-0" id="monthlyBill" value="<%= locals.formData ? formData.monthlyBill : '' %>" placeholder="e.g. 3500" required>
                </div>
                <div class="invalid-feedback-custom"><%= hasBillErr ? errors.monthlyBill : '' %></div>
              </div>

              <!-- Message -->
              <div class="col-md-12 form-group-custom" id="fg-message">
                <label for="message" class="form-label">Additional Message / Requirements</label>
                <textarea name="message" class="form-control form-control-custom" id="message" rows="4" placeholder="e.g. Tell us about your roof area or special requirements..."><%= locals.formData ? formData.message : '' %></textarea>
              </div>

              <div class="col-md-12 mt-4">
                <button type="submit" class="btn btn-premium-primary w-100 py-3">Submit Consultation Request</button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
